# Keep the deployment image small and avoid publishing private/local work files.
.git
.gitignore
.pi
.DS_Store
**/.DS_Store

# Secrets / local environment files
.env
.env.*
!.env.example

# Private source material explicitly excluded by the project charter
a_traiter/

# Local dependency/build artefacts
node_modules/
**/node_modules/
port-manager.db*
dist/
.astro/
.legacy-public/
coverage/
test-results/

# empire-calendrier remains in the build context because Portainer publishes it
# directly. Only its repository/development files are unnecessary at runtime.
empire-calendrier/.git/
empire-calendrier/.githooks/
empire-calendrier/scripts/
empire-calendrier/.gitignore
empire-calendrier/*.md
empire-calendrier/.DS_Store
empire-calendrier/bon-example-calendrier.png

# Agent / editor temp files
*.tmp
*.swp
.~lock.*#

# Untracked local work-in-progress files currently outside the published site
provoxys/exoplanetes/Chapitre3_Outils_au_Sol_enrichi_avec_photos.md
provoxys/sondes/assets/radio-univers.png

# Expérience « Entropia » : clé brute et code archivé, hors manifeste public
provoxys/entropie/Entropie-Mots/openrouter-key.txt
provoxys/entropie/Entropie-Mots/_archive/
