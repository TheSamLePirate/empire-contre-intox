---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  accent: string;
  accentSecondary?: string;
}

const { title, description, canonicalPath, accent, accentSecondary = accent } = Astro.props;
const themeStyle = `--eci-accent:${accent};--eci-accent-secondary:${accentSecondary}`;
---

<BaseLayout {title} {description} {canonicalPath}>
  <div class="eci-dossier" style={themeStyle}>
    <slot />
  </div>
</BaseLayout>

<style>
  .eci-dossier {
    min-height: 100vh;
    background:
      radial-gradient(100% 65% at 10% 0%, color-mix(in srgb, var(--eci-accent) 16%, transparent), transparent 55%),
      linear-gradient(180deg, var(--eci-void), var(--eci-abyss));
  }
</style>
