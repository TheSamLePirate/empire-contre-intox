{
  "extends": "astro/tsconfigs/strictest",
  "include": [
    ".astro/types.d.ts",
    "astro.config.ts",
    "counter/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*",
    "tests/**/*.ts"
  ],
  "exclude": ["dist", ".legacy-public", "empire-calendrier"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noUncheckedIndexedAccess": true,
    "types": ["bun", "node"]
  }
}
