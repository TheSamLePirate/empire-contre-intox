{
  "name": "empire-contre-intox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:legacy": "tsx scripts/prepare-legacy.ts",
    "predev": "npm run prepare:legacy",
    "dev": "astro dev",
    "prebuild": "npm run prepare:legacy",
    "build": "astro build",
    "postbuild": "npm run validate:dist",
    "preview": "astro preview",
    "check": "npm run prepare:legacy && astro check && vitest run && npm run check:calendar && npm run test:calendar",
    "check:calendar": "tsc --noEmit -p calendar-service/tsconfig.json",
    "test:calendar": "bun test ./calendar-service/tests.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:dist": "tsx scripts/validate-dist.ts",
    "build:lives": "bun scripts/build-lives.ts",
    "check:lives": "tsc --noEmit -p lives-service/tsconfig.json",
    "test:lives": "bun test ./lives-service/tests ./calendar-service/lives.tests.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.3",
    "@astrojs/react": "6.0.1",
    "astro": "7.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/bun": "1.3.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
